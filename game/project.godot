; Engine configuration file.
config_version=5

[application]

config/name="Gili Genting"
config/description="Ein Hühnchen. Eine Insel. Eine Schlachtzeit."
config/version="0.3.1"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.03, 0.04, 0.06, 1)
boot_splash/show_image=false

[autoload]

Data="*res://autoload/data.gd"
Game="*res://autoload/game.gd"
Audio="*res://autoload/audio.gd"
UI="*res://autoload/ui.gd"
Story="*res://story/story.gd"

[display]

window/size/viewport_width=640
window/size/viewport_height=360
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"compress/mode": 0,
"detect_3d/compress_to": 0,
"mipmaps/generate": false
}
wav={
"force/mono": true
}

[rendering]

textures/canvas_textures/default_texture_filter=0
textures/vram_compression/import_etc2_astc=true
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=1
lights_and_shadows/positional_shadow/soft_shadow_filter_quality=1
anti_aliasing/quality/msaa_3d=0
environment/defaults/default_clear_color=Color(0.03, 0.04, 0.06, 1)
camera/depth_of_field/depth_of_field_bokeh_shape=1
camera/depth_of_field/depth_of_field_bokeh_quality=2
camera/depth_of_field/depth_of_field_use_jitter=true
